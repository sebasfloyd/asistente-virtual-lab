# Copiá este archivo a .env y completalo.
# .env no se sube a git. No lo pegues en chats ni en capturas.

# Lo más fácil: corré  npm run setup  y este archivo se completa solo,
# sin que pegues el token en ningún chat. Para revisar qué falta: npm run revisar

# Canales. Poné true o false.
TELEGRAM=false
WHATSAPP=false
# Con WHATSAPP=true: qr (WhatsApp Web, no oficial, chip aparte) o api (WhatsApp API oficial de Meta).
WHATSAPP_MODO=qr

# Token que te da @BotFather. Solo vive acá.
TELEGRAM_TOKEN=

# Lo conseguís en un minuto: npm start, abrí el bot y mandale /start. Te contesta "Tu ID es ...".
OWNER_TELEGRAM_ID=

# Mail con el que entraste a Claude Code. claude -p lo mete en el contexto igual,
# aunque el cliente no tenga herramientas. El programa lo borra de lo que se manda.
# Si lo dejás vacío, igual se tapan los mails que no estén escritos en reglas.md.
OWNER_EMAIL=

# Número con código de país, sin + ni espacios. Ejemplo: 5491112345678
OWNER_WHATSAPP=

# A quién atiende el asistente por WhatsApp, además de vos.
# Vacío: solo a vos (así no le contesta a tu familia ni a tus amigos al escanear el QR).
# Números con código de país separados por coma, o la palabra todos.
WHATSAPP_CLIENTES=

# WhatsApp API oficial (Meta Cloud API). Solo con WHATSAPP_MODO=api. Ver README.
# WHATSAPP_API_PHONE_ID=
# WHATSAPP_API_TOKEN=
# WHATSAPP_API_APP_SECRET=
# WHATSAPP_API_VERIFY_TOKEN=
# WHATSAPP_API_PUERTO=8787
# WHATSAPP_API_PLANTILLA=
# WHATSAPP_API_IDIOMA=es_AR

# Código de un solo uso. La primera persona que manda /soyelduenio <código> queda como dueño
# y el código se apaga. Usá una frase larga. Si dejás el texto de ejemplo, el registro no abre.
CODIGO_DUENIO=cambiá-este-código

# aprobar: cada respuesta a un cliente te llega para OK (recomendado).
# auto: se mandan solas solo los temas de "Temas seguros" en reglas.md.
# Precios, descuentos, quejas y pedidos de mails o archivos SIEMPRE te piden OK.
MODO=aprobar

# claude: Claude Code con tu suscripción (sin API key).
# anthropic: API de pago, solo texto, sin calendario ni mail.
# simulacion: no llama a ningún modelo. Sirve para practicar el circuito.
CEREBRO=claude

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# true: un cliente puede pedir huecos libres. El programa calcula solo inicio y fin,
# nunca el título ni el detalle de lo que tenés agendado.
HUECOS_LIBRES=false

# true reservado: agendar un hueco ofrecido a un cliente sin /si del dueño.
# Hoy se ignora: aunque lo pongas en true, el evento solo se crea con /si.
AGENDA_AUTO=false

ZONA_HORARIA=America/Argentina/Buenos_Aires
JORNADA_DESDE=09:00
JORNADA_HASTA=18:00
DURACION_TURNO_MIN=60

# Tope por persona (no aplica al dueño) para que nadie te gaste el cerebro en un loop.
LIMITE_MENSAJES=8
LIMITE_VENTANA_SEG=60

# Carpeta local de sesión, agenda y logs. No la subas a git.
# DIR_DATOS=data

# Nombre con el que se presenta. Vacío = no se presenta con un nombre. No se usa para firmar.
ASISTENTE_NOMBRE=

# true: el dueño puede usar los conectores que ya tenga en Claude Code
# (Gmail, Calendar, Drive, u otros MCP). El cliente nunca los ve.
# Por defecto solo lectura. Para mandar mail o tocar la agenda hace falta /si.
# Drive queda en lectura: no comparte, no borra, no sube ni cambia archivos.
OWNER_CONECTORES=true

# true: en la charla del dueño, Claude también puede editar archivos y usar
# herramientas de escritura. Dejalo en false.
OWNER_ESCRITURA=false

# Opcional. Ruta a un ejecutable `mente` (sin espacios) que recibe el pedido
# como argumento y escribe la respuesta. Vacío = apagado. Solo lo usa el dueño.
MENTE_CMD=

# Dónde se acumulan /aprender y las correcciones de /editar.
# MEMORIA_PATH=memoria.md

# Hora local del resumen al dueño (pendientes, agenda de hoy, mails si hay conector).
# Vacío = no manda resumen. Solo corre mientras el programa está abierto.
# RESUMEN_HORA=09:00

# Cómo se mandan los mensajes. El tono se edita en estilo.md (se relee en cada mensaje).
# PARTIR_MENSAJES=true
# PAUSA_ENTRE_MENSAJES_MS=700
# DEBOUNCE_MENSAJES_MS=2500
# ESTILO_PATH=estilo.md

# Mail propio del asistente (recomendado): una cuenta SUYA, nunca la tuya. Con esto los mails salen de verdad
# después de tu /si. Sin esto, con el conector de Gmail de Claude quedan como borrador.
# Gmail: creá una cuenta para el asistente, activá la verificación en 2 pasos y generá una
# "contraseña de aplicación" en https://myaccount.google.com/apppasswords (16 letras).
# MAIL_USUARIO=martin.asistente@gmail.com
# MAIL_CLAVE_APP=
# MAIL_SMTP=smtp.gmail.com:465
# Con copia a vos en cada mail que mande:
# MAIL_COPIA=
# MAIL_NOMBRE=

# Cuántos segundos se espera a Claude. Las propuestas y resúmenes tardan más.
# TIMEOUT_DUENIO_SEG=300
# TIMEOUT_CLIENTE_SEG=120
